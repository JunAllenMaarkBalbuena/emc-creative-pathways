# Godot 4+ specific ignores
.godot/
/android/

# Runtime-generated data (created by in-game save/export managers)
/data/player_models/
/data/player_drawings/
/data/Exported_drawings/

# Third-party skill sources, fetched by tools/setup-godot-skills.ps1
/vendor/

# One-off scratch: throwaway prompts and completed batch-migration helpers.
# Not project source. See docs/decisions/2026-10-04-portable-handoff.md
/ppt_prompt.txt
/scenes_batchA_run.bat
/scenes_batchA_move.ps1
/scenes/batchA_move.ps1
/test_compile_check.gd
/test_compile_check.gd.uid

# Staging directory used by the godot_ai addon's self-updater. Carries its own
# .gitignore and .gdignore, is 5.7 MB, and is not source.
/addons/.godot_ai_update/

# Output of tools/package-handoff.ps1. Large (~370 MB) and regenerable from any
# commit, so it is never committed - run the script instead.
/dist/

# Export output. Built by:
#   godot --headless --export-release "Web" build/web/index.html
#   godot --headless --export-release "Windows Desktop" build/windows/EMC-Creative-Pathways.exe
# Binaries are large and regenerable, and must never enter history.
/build/

# Python bytecode from the audit tools in tools/ (__pycache__ appears the moment
# any of them is imported rather than run directly).
__pycache__/
*.pyc
