target_duration = 5.0
final_pose_keyframe = true
hints = Array[String](["The story has a beginning, a middle, and an end. Order the beats before moving on.", "Your character should appear in front of the background, with a prop nearby.", "Choose the frame that shows the approach for the missing slot.", "Animation plays best around 12 frames per second.", "Add a movement keyframe before the pose changes.", "Preview your animation before submitting."])
review_checklist_hint = "Check every light is on: character visible, background visible, clear action, framed camera, sufficient lighting, and at least 3 frames."