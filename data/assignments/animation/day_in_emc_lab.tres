&"id": "begin",
&"order": 1,
&"text": "Enter the EMC Laboratory and stop at the entrance."
}, {
&"id": "middle",
&"order": 2,
&"text": "Approach the workstation."
}, {
&"id": "end",
&"order": 3,
&"text": "Strike the final pose at the workstation."
}])
