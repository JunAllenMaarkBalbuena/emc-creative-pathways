"left": "Left_walk",
"right": "Right_walk",
"up": "Back_up_Walk",
"up_left": "2_3Back_Left_up_Walk",
"up_right": "2_3Back_Right_up_Walk"
}
idle_animations = {
"down": "Front_down_idle",
"down_left": "2_3Front_Left_down_Idle",
"down_right": "2_3Front_Right_down_Idle",
"left": "Left_idle",
"right": "Right_idle",
"up": "Back_up_Idle",
"up_left": "2_3Back_Left_up_Idle",
"up_right": "2_3Back_Right_up_Idle"
}
