[gd_resource type="Resource" script_class="FlowchartPuzzleData" format=3]

[ext_resource type="Script" path="res://scripts/programming_lab/flowchart_puzzle_data.gd" id="1"]

[resource]
script = ExtResource("1")
puzzle_id = "final_challenge"
title = "Final Challenge"
difficulty = 3
problem_description = "Combine everything you've learned! 

A bank ATM program:
1. Insert card
2. Enter PIN
3. Check if PIN is correct
   - If wrong: Display error
   - If correct: Choose withdrawal amount
4. Check if balance is sufficient
   - If insufficient: Display 'Insufficient Funds'
   - If sufficient: Dispense cash and display 'Transaction Complete'"
ipo_input = "Input: Card, PIN, Amount"
ipo_process = "Process: Validate PIN, Check balance"
ipo_output = "Output: Cash, Messages"
